    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.7.2",
    "svelte-check": "^4.3.1",
    "typescript": "^5.8.3",
    "vite": "^7.1.7",
    "vite-plugin-wasm": "^3.6.0"
  }
